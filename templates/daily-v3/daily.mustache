<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{title}}</title>
<style>{{{css}}}</style>
</head>
<body>
{{#isFail}}<div class="fail-banner">内容核查未通过（FAIL）· 本页仅供审阅</div>{{/isFail}}
<header class="topnav">
<a class="brand" href="{{brandHome}}">报告站</a>
<nav class="navlinks" aria-label="主导航">{{#nav}}{{#href}}<a href="{{href}}"{{#cur}} aria-current="page"{{/cur}}>{{label}}</a>{{/href}}{{^href}}<span class="muted" title="审阅中">{{label}}</span>{{/href}}{{/nav}}</nav>
<a class="menu" href="#archive" aria-label="打开菜单">菜单</a>
</header>
<div class="shell">
<aside class="side" id="archive" aria-label="报告存档">
<h2>报告存档</h2>
<ul>{{#archive}}<li class="{{cls}}">{{#href}}<a href="{{href}}"{{#cur}} class="cur" aria-current="page"{{/cur}}>{{label}}</a>{{/href}}{{^href}}<span class="muted" title="内容闸 FAIL 已下架">{{label}}</span>{{/href}}</li>{{/archive}}</ul>
<h2>Wiki</h2>
<ul><li><a href="{{wikiHref}}">领域索引</a></li></ul>
</aside>
<main>
<nav class="crumb" aria-label="面包屑"><a href="{{brandHome}}">首页</a><span class="sep" aria-hidden="true">›</span><a href="{{week.href}}">{{week.label}}</a><span class="sep" aria-hidden="true">›</span><span>{{dateShort}} 日报</span></nav>
<nav class="mtoc" aria-label="本页目录"><a href="#verdict">结论</a><a href="#metrics-sec">指标</a><a href="#charts-sec">分布</a><a href="#streak">连续上榜</a><a href="#deep">深度分析</a><a href="#list">榜单</a><a href="#rel">相关报告</a></nav>
<h1>日报 · {{date}}</h1>
<p class="meta">{{week.label}} · 数据抓取 {{scrapedAtLocal}} · 生成 {{generatedAtLocal}}{{#replayNote}} · {{.}}{{/replayNote}}</p>

<!-- 1 结论 hero -->
<section class="sec" id="verdict">
<div class="hero">
<p class="lead">{{hero.lead}}</p>
{{#hero.sub}}<p class="sub">{{hero.sub}}</p>{{/hero.sub}}
<div class="hype"><span class="pill hype-pill">热度 {{verdict.hypeScore}}/5 <span class="dots" aria-hidden="true">{{verdict.hypeDots}}</span></span><span>{{verdict.hypeReason}}</span></div>
</div>
</section>

<!-- 2 指标卡 (走势图①) -->
<section class="sec" id="metrics-sec">
<div class="grid">
{{#metrics}}
<div class="card m"><div class="ml">{{label}}</div><div class="mrow"><div class="mv">{{value}}</div>{{#spark}}<svg class="spark" viewBox="0 0 {{w}} {{h}}" width="{{w}}" height="{{h}}" role="img"><polyline points="{{points}}" fill="none" stroke="{{color}}" stroke-width="2.5" stroke-linejoin="round"/><circle cx="{{lx}}" cy="{{ly}}" r="3.5" fill="{{dot}}"/></svg>{{/spark}}</div><div class="mc">{{prevLabel}} <span class="{{dYCls}}">{{dYArrow}}{{dYText}}</span>{{#d7Text}} · {{d7Label}} <span class="{{d7Cls}}">{{d7Arrow}}{{d7Text}}</span>{{/d7Text}}</div></div>
{{/metrics}}
</div>
<p class="read">{{sparkNote}}</p>
</section>



<!-- 3 新增星 | 语言+类型 (图②③) -->
<div class="two" id="charts-sec">
<section class="card bars">
<h2>新增星 Top 8</h2>
<p class="read">{{barsNote}}</p>
<div class="barlist">
{{#bars}}<div class="bar"><div class="bmeta"><div class="bn">{{name}}</div><div class="bd">{{desc}}</div></div><div class="bt"><div class="bf" style="width:{{pct}}%;background:{{color}}"></div></div><div class="bv">+{{value}}</div></div>
{{/bars}}</div>
</section>
<section class="card langs">
<h2>语言分布</h2>
<p class="read">{{langNote}}</p>
{{#langRows}}<div class="srow"><div class="sl">{{label}}</div><div class="stk">{{#segs}}<div class="seg" style="flex:{{n}};background:{{color}};color:{{textColor}}"><span>{{n}}</span></div>{{/segs}}</div></div>
{{/langRows}}<div class="legend">{{#langLegend}}<span class="lg"><i style="background:{{color}}"></i>{{name}}</span>{{/langLegend}}</div>
<h3 class="subhead">类型分布</h3>
{{#typeRows}}<div class="srow"><div class="sl">{{label}}</div><div class="stk">{{#segs}}<div class="seg" style="flex:{{n}};background:{{color}};color:{{textColor}}"><span>{{n}}</span></div>{{/segs}}</div></div>
{{/typeRows}}<div class="legend">{{#typeLegend}}<span class="lg"><i style="background:{{color}}"></i>{{name}}</span>{{/typeLegend}}</div>
</section>
</div>

<!-- 4 连续上榜 -->
<section class="sec" id="streak">
<h2>连续上榜 <small>≥2 天，共 {{streakCount}} 个</small></h2>
<div class="card"><ul class="streak">{{#streak}}<li><span class="days">{{days}}<small>天</small></span><div class="who"><a href="#{{anchor}}">{{fullName}}</a><p>{{text}}</p></div><span class="today">今日 +{{todayStars}}</span></li>{{/streak}}</ul></div>
</section>


<!-- 5 深度分析 + 建议 ≤3 -->
<section class="sec card text quote" id="deep">
<h2>深度分析</h2>
<div class="prose"><p>{{analysis}}</p></div>
<h3 class="subhead" style="margin-top:20px">建议</h3>
<ol class="advice-list">
{{#advice}}<li>{{text}}</li>
{{/advice}}</ol>
</section>

<!-- 6 项目榜单 13 条完整 -->
<section class="sec" id="list">
<h2>项目榜单 <small>按今日新增排序，共 {{total}} 个</small></h2>
<div class="plist">
{{#projects}}
<article class="card proj" id="{{anchor}}">
<span class="rank">{{rank}}</span>
<div>
<div class="name"><h3><a href="{{url}}">{{fullName}}</a></h3><span class="pill{{#tagNew}} new{{/tagNew}}">{{tag}}</span></div>
<p class="one">{{oneSentence}}</p>
<p class="desc">{{descZh}}</p>
<div class="tags"><span class="pill">{{typeName}}</span><span class="pill">{{language}}</span><span class="pill">社区 {{community}}</span></div>
</div>
<div class="pnums"><div class="hot"><b>+{{todayStars}}</b><span>今日新增</span></div><div><b>{{starsFmt}}</b><span>累计 Stars</span></div><div><b>{{forksFmt}}</b><span>Fork</span></div><div><b>{{streakText}}</b><span>连续上榜</span></div><div><b>{{appearancesText}}</b><span>累计上榜</span></div></div>
</article>
{{/projects}}
</div>
</section>

<!-- 7 相关报告 -->
<section class="sec" id="rel">
<h2>相关报告</h2>
<div class="rel">{{#related}}{{#href}}<a href="{{href}}"><span>{{title}}</span><small>{{sub}}</small></a>{{/href}}{{^href}}<span class="muted" title="内容闸 FAIL 已下架"><span>{{title}}</span><small>{{sub}}</small></span>{{/href}}{{/related}}</div>
</section>

<footer>{{footer}}</footer>
</main>
<nav class="toc" aria-label="本页目录">
<h2>本页目录</h2>
<ul>
<li><a href="#verdict">今日结论</a></li>
<li><a href="#metrics-sec">指标走势</a></li>
<li><a href="#charts-sec">分布与榜单</a></li>
<li><a href="#streak">连续上榜</a></li>
<li><a href="#deep">深度分析</a></li>
<li><a href="#list">项目榜单</a></li>
<li><a href="#rel">相关报告</a></li>
</ul>
</nav>
</div>
</body>
</html>
<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{title}}</title>
<style>{{{css}}}</style>
</head>
<body>
<header class="topnav">
<a class="brand" href="{{brandHome}}">报告站</a>
<nav class="navlinks" aria-label="主导航">{{#nav}}{{#href}}<a href="{{href}}"{{#cur}} aria-current="page"{{/cur}}>{{label}}</a>{{/href}}{{^href}}<span{{#cur}} aria-current="page"{{/cur}}>{{label}}</span>{{/href}}{{/nav}}</nav>
<a class="menu" href="#archive" aria-label="打开菜单">菜单</a>
</header>
<div class="shell">
<aside class="side" id="archive" aria-label="报告存档">
<h2>快捷</h2>
<ul>
<li><a href="#entries">三入口</a></li>
<li><a href="#top5">今日 Top5</a></li>
<li><a href="#archives">存档</a></li>
</ul>
</aside>
<main>
<nav class="crumb" aria-label="面包屑"><span>首页</span></nav>
<h1>今日看什么</h1>
<p class="meta">{{meta}}</p>

<section class="sec" id="entries">
<div class="grid3">
{{#entries}}
<div class="entry"><div class="mc">{{kind}}</div><h3>{{title}}</h3><p class="sum">{{sum}}</p><div class="nums">{{#nums}}<span>{{label}} <b>{{value}}</b></span>{{/nums}}</div>{{#linkable}}<a class="go" href="{{href}}">{{go}}</a>{{/linkable}}{{^linkable}}<span class="go" style="opacity:.45;pointer-events:none;cursor:not-allowed" title="内容闸 FAIL 已下架">{{go}}</span>{{/linkable}}</div>
{{/entries}}
</div>
<p class="note">累计六卡不当主货；本页不展示近14日趋势（已拍删）。</p>
</section>

<section class="sec" id="top5">
<h2>今日 Top5 <small>链当日日报 · {{topDate}}</small></h2>
<div class="card">
<ul class="list rank">{{#topProjects}}<li><span>{{rank}}</span><div><b><a href="{{href}}">{{fullName}}</a></b><br><span class="mc">{{blurb}}</span></div><div class="days">{{stars}}</div><span class="tag {{tagCls}}">{{tag}}</span></li>{{/topProjects}}{{^topProjects}}<li><span class="mc">暂无今日榜单</span></li>{{/topProjects}}</ul>
<p class="note">链接指向当日日报，非历史热榜。</p>
</div>
</section>

<section class="sec" id="archives">
<h2>存档</h2>
<div class="card grid3">
<div><div class="ml" style="font-weight:700;margin-bottom:8px">日报</div><ul class="bullets" style="font-size:14px">{{#archives.daily}}<li><a href="{{href}}">{{label}}</a></li>{{/archives.daily}}</ul></div>
<div><div class="ml" style="font-weight:700;margin-bottom:8px">周报</div><ul class="bullets" style="font-size:14px">{{#archives.weekly}}<li>{{#href}}<a href="{{href}}">{{label}}</a>{{/href}}{{^href}}<span title="内容闸 FAIL 已下架">{{label}}</span>{{/href}}</li>{{/archives.weekly}}</ul></div>
<div><div class="ml" style="font-weight:700;margin-bottom:8px">月报</div><ul class="bullets" style="font-size:14px">{{#archives.monthly}}<li>{{#href}}<a href="{{href}}">{{label}}</a>{{/href}}{{^href}}<span title="内容闸 FAIL 已下架">{{label}}</span>{{/href}}</li>{{/archives.monthly}}</ul></div>
</div>
</section>

<footer>{{footer}}</footer>
</main>
</div>
</body>
</html>

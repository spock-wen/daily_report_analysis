<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{title}}</title>
<style>{{{css}}}</style>
</head>
<body>
{{#isFail}}<div class="fail-banner">内容核查未通过（FAIL）· 本页仅供审阅</div>{{/isFail}}
<header class="topnav">
<a class="brand" href="{{brandHome}}">报告站</a>
<nav class="navlinks" aria-label="主导航">{{#nav}}<a href="{{href}}"{{#cur}} aria-current="page"{{/cur}}>{{label}}</a>{{/nav}}</nav>
<a class="menu" href="#archive" aria-label="打开菜单">菜单</a>
</header>
<div class="shell">
<aside class="side" id="archive" aria-label="报告存档">
<h2>本页目录</h2>
<ul>
<li><a href="#pattern">vs 上月</a></li>
<li><a href="#top">本月 Top</a></li>
<li><a href="#crowns">三大王冠</a></li>
<li><a href="#langdom">语言·领域</a></li>
<li><a href="#insights">深度洞察</a></li>
<li><a href="#weeks">四周主题</a></li>
<li><a href="#daily-chart">日度折线</a></li>
<li><a href="#trend">四周柱</a></li>
<li><a href="#kpi">关键指标</a></li>
</ul>
</aside>
<main>
<nav class="crumb" aria-label="面包屑"><a href="{{brandHome}}">首页</a><span class="sep">/</span><span>月报</span><span class="sep">/</span><span>{{crumbMonth}}</span></nav>
<nav class="mtoc" aria-label="本页目录"><a href="#pattern">格局</a><a href="#top">Top</a><a href="#crowns">王冠</a><a href="#langdom">环比</a><a href="#insights">洞察</a><a href="#weeks">四周</a><a href="#daily-chart">折线</a><a href="#trend">柱</a><a href="#kpi">指标</a></nav>
<h1>{{h1}}</h1>
<p class="meta">{{meta}}</p>

<section class="sec" id="pattern">
<h2>本月 vs 上月 · 格局变了什么</h2>
<div class="card">
<table class="tbl"><thead><tr><th>指标</th><th class="num">本月</th><th class="num">上月</th><th class="num">变化</th></tr></thead>
<tbody>{{#patternRows}}<tr><td>{{label}}</td><td class="num">{{curr}}</td><td class="num">{{prev}}</td><td class="num {{deltaCls}}">{{delta}}</td></tr>{{/patternRows}}</tbody></table>
<div class="narr" style="margin-top:14px"><h3>三个结构性变化</h3><p class="prose">{{patternChanges}}</p></div>
<div class="hero" style="margin-top:14px;margin-bottom:0"><div class="lead">{{themeLead}}</div></div>
</div>
</section>

<section class="sec" id="top">
<h2>本月 Top <small>按本月新增</small></h2>
<div class="card">
<ul class="list rank">{{#topRows}}<li><span>{{rank}}</span><div><b><a href="{{url}}" rel="noopener">{{fullName}}</a></b><br><span class="mc">{{meta}}</span></div><div class="days">{{monthStars}}<small>新增</small></div><div class="mc">总星 {{totalStars}}</div></li>{{/topRows}}</ul>
<p class="note">排序口径=本月新增星（日榜回算），非站内 score。</p>
</div>
</section>

<section class="sec" id="crowns">
<h2>三大王冠 <small>持久 / 单日星增 / 新秀</small></h2>
<div class="crown">{{#crowns}}<div class="card"><h3>{{title}}</h3><p><b>{{name}}</b></p><p class="mc">{{meta}}</p></div>{{/crowns}}</div>
</section>

<section class="sec" id="langdom">
<h2>语言环比 + 领域热度环比</h2>
<div class="grid2">
<div class="card"><h3 style="font-size:15px;margin-bottom:8px">语言分布（项目数）</h3>
<table class="tbl"><thead><tr><th>语言</th><th class="num">项目</th><th class="num">环比</th><th class="num">同向星数环比*</th></tr></thead>
<tbody>{{#langRows}}<tr><td>{{label}}</td><td class="num">{{count}}</td><td class="num {{countCls}}">{{countRate}}</td><td class="num {{starCls}}">{{starRate}}</td></tr>{{/langRows}}</tbody></table>
<p class="note">* aggregation 无语言星数时，星数环比暂与项目数环比同向占位。</p>
</div>
<div class="card"><h3 style="font-size:15px;margin-bottom:8px">领域热度（记录数占比）</h3>
<table class="tbl"><thead><tr><th>领域</th><th class="num">占比</th><th class="num">上月</th><th class="num">变化</th></tr></thead>
<tbody>{{#domainRows}}<tr><td>{{label}}</td><td class="num">{{share}}</td><td class="num">{{prevShare}}</td><td class="num {{deltaCls}}">{{delta}}</td></tr>{{/domainRows}}</tbody></table>
<p class="note">用表，不用 Wiki 域墙。</p>
</div>
</div>
</section>

<section class="sec" id="insights">
<h2>深度洞察 <small>含回落</small></h2>
<div class="card">{{#insights}}<div class="narr"><h3>{{index}}. {{title}}</h3><p class="prose">{{body}}</p></div>{{/insights}}</div>
</section>

<section class="sec" id="weeks">
<h2>四周主题条 <small>链周报</small></h2>
<div class="weekbar">{{#weekBars}}<a href="{{href}}"><b>{{week}}</b>{{theme}}</a>{{/weekBars}}</div>
</section>

<section class="sec" id="daily-chart">
<h2>日度新增 Star <small>{{crumbMonth}}</small></h2>
<div class="card chart-card">
<p class="chart-sub">横轴日 · 纵轴当日新增 · 标峰值/谷值/均值</p>
<div class="svg-wrap">{{{dailyLineSvg}}}</div>
<p class="note">{{dailyLineNote}}</p>
</div>
</section>

<section class="sec" id="trend">
<h2>四周新增 Star <small>柱状</small></h2>
<div class="card chart-card" id="week-bars-chart">
<p class="chart-sub">四周各一根柱 + 柱端数值</p>
<div class="svg-wrap">{{{weekBarsSvg}}}</div>
<p class="note">{{weekBarsNote}}</p>
</div>
</section>

<section class="sec" id="kpi">
<h2>关键指标一览</h2>
<div class="card">
<table class="tbl"><thead><tr><th>项</th><th>值</th></tr></thead>
<tbody>{{#kpiRows}}<tr><td>{{label}}</td><td>{{value}}</td></tr>{{/kpiRows}}</tbody></table>
</div>
</section>

<section class="sec" id="fulllist">
<details class="fold"><summary>完整列表（折叠）</summary><p>{{fullNote}}</p></details>
<p class="note"><a href="{{wikiHref}}">Wiki 入口 → 知识库</a>（无正文墙）</p>
<p class="note">{{caption}}</p>
</section>

<footer>{{footer}}</footer>
</main>
</div>
</body>
</html>

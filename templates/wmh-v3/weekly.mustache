<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{title}}</title>
<style>{{{css}}}</style>
</head>
<body>
{{#isFail}}<div class="fail-banner">内容核查未通过（FAIL）· 本页仅供审阅</div>{{/isFail}}
<header class="topnav">
<a class="brand" href="{{brandHome}}">报告站</a>
<nav class="navlinks" aria-label="主导航">{{#nav}}{{#href}}<a href="{{href}}"{{#cur}} aria-current="page"{{/cur}}>{{label}}</a>{{/href}}{{^href}}<span class="muted" title="审阅中">{{label}}</span>{{/href}}{{/nav}}</nav>
<a class="menu" href="#archive" aria-label="打开菜单">菜单</a>
</header>
<div class="shell">
<aside class="side" id="archive" aria-label="报告存档">
<h2>本页目录</h2>
<ul>
<li><a href="#metrics">指标</a></li>
<li><a href="#highlights">本期速览</a></li>
<li><a href="#overview">本周总览</a></li>
<li><a href="#narratives">核心叙事</a></li>
<li><a href="#roster">三类榜单</a></li>
<li><a href="#tracks">赛道复盘</a></li>
<li><a href="#lookahead">下周看点</a></li>
</ul>
</aside>
<main>
<nav class="crumb" aria-label="面包屑"><a href="{{brandHome}}">首页</a><span class="sep">/</span><span>周报</span><span class="sep">/</span><span>{{crumbWeek}}</span></nav>
<nav class="mtoc" aria-label="本页目录"><a href="#metrics">指标</a><a href="#highlights">速览</a><a href="#overview">总览</a><a href="#narratives">叙事</a><a href="#roster">榜单</a><a href="#tracks">赛道</a><a href="#lookahead">看点</a></nav>
<h1>{{h1}}</h1>
<p class="meta">{{meta}}</p>

<section class="sec" id="metrics">
<div class="grid4">
{{#metrics}}
<div class="card m"><div class="ml stat-label">{{label}}</div><div class="mv stat-value">{{value}}</div><div class="mc {{captionCls}}">{{caption}}</div></div>
{{/metrics}}
</div>
<p class="note">{{caption}}</p>
</section>

<section class="sec" id="highlights">
<h2>本期速览 <small>约 4 条</small></h2>
<div class="card"><ul class="bullets">{{#highlights}}<li>{{.}}</li>{{/highlights}}</ul></div>
</section>

<section class="sec" id="overview">
<h2>本周总览 <small>结构 · 头部 · 分类环比</small></h2>
<div class="overview-split">
<div class="card">
<p class="prose">{{overviewText}}</p>
{{#hasTrackOverview}}
<table class="tbl" style="margin-top:12px"><thead><tr><th>赛道</th><th class="num">本周席位</th><th class="num">上周</th><th class="num">星数环比</th></tr></thead>
<tbody>{{#trackOverviewRows}}<tr><td>{{label}}</td><td class="num">{{currSeats}}</td><td class="num">{{prevSeats}}</td><td class="num {{starCls}}">{{starRateText}}</td></tr>{{/trackOverviewRows}}</tbody></table>
{{/hasTrackOverview}}
</div>
{{#hasTopChart}}
<div class="card chart-card" id="week-top-chart">
<h3 class="chart-h">本周 Top≤10 · 按本周新增星</h3>
<p class="chart-sub">对标飞书周榜 · 静态标注可读（勿仅靠 tooltip）</p>
<div class="svg-wrap">{{{topChartSvg}}}</div>
<p class="note">{{topChartNote}}</p>
</div>
{{/hasTopChart}}
</div>
</section>

<section class="sec" id="narratives">
<h2>核心叙事 <small>≤3 节</small></h2>
<div class="card">
{{#narratives}}
<div class="narr"><h3>{{index}}. {{title}}</h3><p class="prose">{{body}}</p></div>
{{/narratives}}
</div>
</section>

<section class="sec" id="roster">
<h2>三类榜单 <small>新面孔 / 连续 / 回归</small></h2>
<div class="grid3">
<div class="card"><h3 class="roster-h new">新面孔</h3><ul class="list">{{#rosterNew}}<li><span class="tag {{tagCls}}">{{tag}}</span><div><b><a href="{{url}}" rel="noopener">{{fullName}}</a></b><br><span class="mc">{{blurb}}</span><br><span class="mc">累计上榜 {{appearancesText}}</span></div><div class="days">{{valueText}}<small>{{valueUnit}}</small></div></li>{{/rosterNew}}{{^rosterNew}}<li><span class="mc">本期无新面孔</span></li>{{/rosterNew}}</ul></div>
<div class="card"><h3 class="roster-h cont">连续上榜</h3><ul class="list">{{#rosterCont}}<li><span class="tag {{tagCls}}">{{tag}}</span><div><b><a href="{{url}}" rel="noopener">{{fullName}}</a></b><br><span class="mc">{{blurb}}</span><br><span class="mc">累计上榜 {{appearancesText}}</span></div><div class="days">{{valueText}}<small>{{valueUnit}}</small></div></li>{{/rosterCont}}{{^rosterCont}}<li><span class="mc">本期无连续项</span></li>{{/rosterCont}}</ul></div>
<div class="card"><h3 class="roster-h ret">回归 &amp; 老面孔</h3><ul class="list">{{#rosterRet}}<li><span class="tag {{tagCls}}">{{tag}}</span><div><b><a href="{{url}}" rel="noopener">{{fullName}}</a></b><br><span class="mc">{{blurb}}</span><br><span class="mc">累计上榜 {{appearancesText}}</span></div><div class="days">{{valueText}}<small>{{valueUnit}}</small></div></li>{{/rosterRet}}{{^rosterRet}}<li><span class="mc">本期无回归项</span></li>{{/rosterRet}}</ul></div>
</div>
</section>

<section class="sec" id="tracks">
<h2>赛道复盘 <small>本周 vs 上周</small></h2>
<div class="card">
<table class="tbl"><thead><tr><th>赛道</th><th class="num">席位</th><th class="num">上周</th><th class="num">变化</th><th class="num">星数环比</th><th>一句话</th></tr></thead>
<tbody>{{#trackRows}}<tr><td>{{label}}</td><td class="num">{{currSeats}}</td><td class="num">{{prevSeats}}</td><td class="num {{seatCls}}">{{seatDeltaText}}</td><td class="num {{starCls}}">{{starRateText}}</td><td>{{note}}</td></tr>{{/trackRows}}</tbody></table>
<p class="note">{{trackNote}}</p>
</div>
</section>

<section class="sec" id="lookahead">
<h2>下周看点 <small>≤3</small></h2>
<div class="card"><ol class="look">{{#lookahead}}<li><span class="q">{{index}}.</span>{{text}}</li>{{/lookahead}}</ol></div>
</section>

<section class="sec" id="fulllist">
<details class="fold"><summary>完整列表（折叠）· 检索用 · {{fullCount}} 项</summary>
<ul class="list rank">{{#fullList}}<li><span>{{rank}}</span><div><b><a href="{{url}}" rel="noopener">{{fullName}}</a></b><br><span class="mc">{{track}} · {{blurb}} · 累计上榜 {{appearancesText}}</span></div><div class="days">{{stars}}<small>星</small></div><span class="mc"></span></li>{{/fullList}}</ul>
</details>
</section>

<section class="sec" id="cmp">
<h2>相对上周 <small>短对照</small></h2>
<div class="card">
<div class="cmp-row head"><span>指标</span><span class="h">本周</span><span>上周</span><span>变化</span></div>
{{#cmpRows}}<div class="cmp-row"><span>{{label}}</span><span class="h">{{curr}}</span><span>{{prev}}</span><span class="{{deltaCls}}">{{delta}}</span></div>{{/cmpRows}}
</div>
</section>

<footer>{{footer}}</footer>
</main>
</div>
</body>
</html>
